{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,

    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "preserve",

    "baseUrl": ".",

    "paths": {
      "@/*": ["./*"],

      "@talentdash/types": [
        "../../packages/types/src"
      ],

      "@talentdash/utils": [
        "../../packages/utils/src"
      ],

      "@talentdash/ui": [
        "../../packages/ui/src"
      ],

      "@talentdash/db": [
        "../../packages/db/src"
      ],

      "@talentdash/auth": [
        "../../packages/auth/src"
      ]
    }
  }
}