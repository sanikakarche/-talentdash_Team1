    "db:seed": "tsx src/seed.ts",

    "typecheck": "tsc --noEmit"
  },

  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^6.8.2",
    "@prisma/extension-accelerate": "^2.0.1",
    "zod": "^3.24.4"
  },

  "devDependencies": {
    "@types/node": "^22.15.29",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}