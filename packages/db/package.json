{
  "name": "@talentdash/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",

  "main": "./src/index.ts",
  "types": "./src/index.ts",

  "exports": {
    ".": "./src/index.ts"
  },

  "scripts": {
    "build": "tsc",

    "db:generate": "prisma generate",
